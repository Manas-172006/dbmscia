APP_ENV=development
APP_NAME=Found It API

# --- Database accounts -------------------------------------------------
# Create these MySQL users locally (see README) and use unique passwords.
# Never commit the real values: copy this file to .env and edit it there.
DATABASE_URL=mysql+pymysql://foundit_app:REPLACE_WITH_A_UNIQUE_APP_PASSWORD@127.0.0.1:3307/found_it_db
SQL_EXPLORER_DATABASE_URL=mysql+pymysql://foundit_explorer:REPLACE_WITH_A_DIFFERENT_UNIQUE_PASSWORD@127.0.0.1:3307/found_it_db

# --- Secrets: each teammate sets their own values in .env ---------------
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SET_YOUR_OWN_ADMIN_PASSWORD

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
FRONTEND_ORIGIN=http://localhost:5173
